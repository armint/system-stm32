# libArT/cmake/system-stm32Config.cmake.in
@PACKAGE_INIT@

# Ensure dependencies are available before loading the targets they reference
include(CMakeFindDependencyMacro)

# Below C++20, hw::span is span_compat::span (src/utils/Span.h).
if(@SYSTEM_STM32_USE_SPAN_COMPAT@)
    find_dependency(span-compat 1 CONFIG)
endif()

# Load the exported targets for this package (installed by install(EXPORT ...))
include("${CMAKE_CURRENT_LIST_DIR}/system-stm32-targets.cmake")

if(@SYSTEM_STM32_USE_SPAN_COMPAT@)
    set_property(TARGET art::system-stm32 APPEND PROPERTY INTERFACE_LINK_LIBRARIES span-compat::span-compat)
endif()

# Optional: ensure all requested components are found (if you define any)
check_required_components(system-stm32)